{
  "name": "spotify-track-manager",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "description": "Local web app for browsing and organizing a Spotify library",
  "scripts": {
    "dev": "concurrently -k -n frontend,backend -c green,magenta \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "dev:backend": "pnpm --filter @stm/backend dev",
    "dev:frontend": "pnpm --filter @stm/frontend dev",
    "build": "pnpm -r build",
    "start": "node apps/backend/dist/server.cjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint \"apps/backend/src/**/*.ts\" \"apps/frontend/src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^10.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.1"
  }
}
